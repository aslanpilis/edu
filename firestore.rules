rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Ebeveyn kullanıcı belgesi güvenliği
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Çocuk profilleri alt koleksiyonu (Parent-Child Isolation)
      match /children/{childId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // İlerleme ve sınav kayıtları
    match /progress/{progressId} {
      allow read, write: if request.auth != null;
    }

    // Başarılar ve rozetler
    match /achievements/{achievementId} {
      allow read, write: if request.auth != null;
    }

    // Günlük kullanım logları
    match /daily_logs/{logId} {
      allow read, write: if request.auth != null;
    }

    // Müfredat, modüller ve ders içerikleri (Herkese okuma açık, yazma kapalı)
    match /curriculums/{curriculumId} {
      allow read: if true;
      allow write: if false;
    }

    match /modules/{moduleId} {
      allow read: if true;
      allow write: if false;
    }

    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
