# Firebase Credentials Template
# Firebase Konsolunuzdan (Project Settings > General > Your apps) aldığınız değerleri buraya giriniz.
# Girilmediğinde uygulama yerleşik akıllı simülasyon/demo modunda çalışır.

VITE_FIREBASE_API_KEY=AIzaSyExampleKey123456789
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-edtech-project
VITE_FIREBASE_STORAGE_BUCKET=your-edtech-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
